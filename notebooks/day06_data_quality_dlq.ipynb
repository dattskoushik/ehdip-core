   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Day 6: Data Quality, Validation & Quarantine DLQ Engine\n",
    "\n",
    "This notebook runs validation on intentional bad records verifying JSON error manifests routing to the quarantine DLQ, using PyDeequ concepts."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from pyspark.sql import SparkSession\n",
    "import pyspark.sql.functions as F\n",
    "\n",
    "# Set SPARK_VERSION for PyDeequ\n",
    "os.environ['SPARK_VERSION'] = '3.3'\n",
    "\n",
    "# Initialize Spark with Iceberg and PyDeequ\n",
    "spark = SparkSession.builder \\\n",
    "    .appName(\"Day06_DQ_DLQ\") \\\n",
    "    .config(\"spark.jars.packages\", \"org.apache.iceberg:iceberg-spark-runtime-3.3_2.12:1.3.1,org.apache.iceberg:iceberg-aws-bundle:1.3.1,com.amazon.deequ:deequ:2.0.3-spark-3.3\") \\\n",
    "    .config(\"spark.sql.extensions\", \"org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions\") \\\n",
    "    .config(\"spark.sql.catalog.local\", \"org.apache.iceberg.spark.SparkCatalog\") \\\n",
    "    .config(\"spark.sql.catalog.local.type\", \"hadoop\") \\\n",
    "    .config(\"spark.sql.catalog.local.warehouse\", \"/tmp/ehdip_warehouse\") \\\n",
    "    .getOrCreate()\n",
    "\n",
    "print(\"SparkSession initialized with PyDeequ capabilities.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate mock OMOP condition_occurrence data (with some bad records)\n",
    "data = [\n",
    "    (1, 101, 32020, \"2023-01-15\"), # Valid\n",
    "    (2, None, 32020, \"2023-01-16\"), # Invalid: missing person_id\n",
    "    (3, 103, None, \"2023-01-17\"), # Invalid: missing concept_id\n",
    "    (4, 104, 32020, \"2099-12-31\"), # Invalid: future date\n",
    "    (5, 105, 32020, \"2023-02-01\")  # Valid\n",
    "]\n",
    "columns = [\"condition_occurrence_id\", \"person_id\", \"condition_concept_id\", \"condition_start_date\"]\n",
    "\n",
    "df = spark.createDataFrame(data, columns)\n",
    "df = df.withColumn(\"condition_start_date\", F.to_date(F.col(\"condition_start_date\")))\n",
    "\n",
    "print(\"Incoming Batch:\")\n",
    "df.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# In a real PyDeequ implementation, we would use VerificationSuite. \n",
    "# For this notebook simulation and DLQ routing, we implement the constraints via native Spark to generate the error manifest.\n",
    "\n",
    "df_validated = df.withColumn(\n",
    "    \"is_valid_concept\", F.col(\"condition_concept_id").isNotNull()\n",
    ").withColumn(\n",
    "    \"is_valid_date\", (F.col(\"condition_start_date\") <= F.current_date())\n",
    ").withColumn(\n",
    "    \"is_valid_person\", F.col(\"person_id\").isNotNull()\n",
    ")\n",
    "\n",
    "df_validated = df_validated.withColumn(\n",
    "    \"is_valid_record\", \n",
    "    F.col(\"is_valid_concept\") & F.col(\"is_valid_date\") & F.col(\"is_valid_person\")\n",
    ")\n",
    "\n",
    "# Route Valid Data\n",
    "df_valid = df_validated.filter(F.col(\"is_valid_record\") == True).drop(\n",
    "    \"is_valid_concept\", \"is_valid_date\", \"is_valid_person\", \"is_valid_record\"\n",
    ")\n",
    "print(\"Valid Records (Routed to Silver):\")\n",
    "df_valid.show()\n",
    "\n",
    "# Route Invalid Data to DLQ with JSON Manifest\n",
    "df_invalid = df_validated.filter(F.col(\"is_valid_record\") == False)\n",
    "df_invalid = df_invalid.withColumn(\n",
    "    \"error_manifest\", \n",
    "    F.to_json(F.struct(\n",
    "        F.col(\"is_valid_concept\"), \n",
    "        F.col(\"is_valid_date\"), \n",
    "        F.col(\"is_valid_person\")\n",
    "    ))\n",
    ").drop(\"is_valid_concept\", \"is_valid_date\", \"is_valid_person\", \"is_valid_record\")\n",
    "\n",
    "print(\"Invalid Records (Routed to DLQ with manifest):\")\n",
    "df_invalid.show(truncate=False)"
   ]
  }
 ],
